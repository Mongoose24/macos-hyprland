# LaunchAgents do not always inherit Homebrew's PATH after a macOS update.
# Keep signal actions able to find SketchyBar when yabai is started by launchd.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

SKETCHYBAR_BIN="$(command -v sketchybar 2>/dev/null || echo /opt/homebrew/bin/sketchybar)"
# Window notifications can arrive before Mission Control exposes the new AX
# window. Delay the aggregate refresh so its query sees the settled window.
REFRESH_SPACES="sleep 1; SENDER=windows_on_spaces NAME=yabai CONFIG_DIR=$HOME/.config/sketchybar $HOME/.config/sketchybar/plugins/yabai.sh"

yabai -m config external_bar all:30:0

# Tiling style:bsp, stack, or float
yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config window_animation_duration 0.0

# Padding
yabai -m config top_padding 5
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 5

# Mouse settings
yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Excluded apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Raycast$" manage=off

# Sketchybar integration
yabai -m signal --add event=window_focused action="$SKETCHYBAR_BIN --trigger window_focus"
yabai -m signal --add event=window_created action="$REFRESH_SPACES"
yabai -m signal --add event=window_destroyed action="$REFRESH_SPACES"
yabai -m signal --add event=window_moved action="$REFRESH_SPACES"
yabai -m signal --add event=window_minimized action="$REFRESH_SPACES"
yabai -m signal --add event=window_deminimized action="$REFRESH_SPACES"
yabai -m signal --add event=space_changed action="$SKETCHYBAR_BIN --trigger space_change; $REFRESH_SPACES"
yabai -m signal --add event=space_created action="$SKETCHYBAR_BIN --trigger space_change; $REFRESH_SPACES"
yabai -m signal --add event=space_destroyed action="$SKETCHYBAR_BIN --trigger space_change; $REFRESH_SPACES"
yabai -m signal --add event=display_changed action="$SKETCHYBAR_BIN --trigger display_change; $REFRESH_SPACES"

# Keyboard shortcuts are handled by skhd; see ~/.skhdrc.
