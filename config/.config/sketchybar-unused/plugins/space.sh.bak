#!/bin/bash

# Keep the app icons visible on the focused space.  The old configuration set
# label.width=0 for the selected space, which made the app list slide away.
update() {
  sketchybar --set "$NAME" icon.highlight="$SELECTED" label.width=dynamic
}

mouse_clicked() {
  if [ "$BUTTON" = "right" ]; then
    yabai -m space --destroy "$SID"
    sketchybar --trigger space_change --trigger windows_on_spaces
  else
    yabai -m space --focus "$SID" 2>/dev/null
    sketchybar --trigger space_change
  fi
}

case "$SENDER" in
  "mouse.clicked") mouse_clicked
  ;;
  *) update
  ;;
esac
